<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络通信权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 手机系统日历读写权限 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      allowBackup=false：学号、姓名、GPA 与登录凭据全部属于个人隐私，不进入云备份与换机传输。
      dataExtractionRules 覆盖 Android 12+ 的备份/迁移规则；Android 11 及以下由 allowBackup=false 兜底。
    -->
    <application
        android:name=".QutApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QutCampusAssistant"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 主界面 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.QutCampusAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件广播接收器：透明背景，展示指定日期的课程 -->
        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="cn.edu.qut.campus.ACTION_WIDGET_PREV_DAY" />
                <action android:name="cn.edu.qut.campus.ACTION_WIDGET_NEXT_DAY" />
                <action android:name="cn.edu.qut.campus.ACTION_WIDGET_REFRESH" />
                <!-- 跨零点 / 改时间 / 换时区：立即把小组件切回「今日」，不必等 30 分钟的更新周期 -->
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>

    </application>

</manifest>
