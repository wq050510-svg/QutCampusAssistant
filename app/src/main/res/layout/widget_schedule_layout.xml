<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件布局（透明底，跟随壁纸）。
  所有 android:text 留空：真实文案由 ScheduleWidgetProvider 通过 RemoteViews 注入，
  tools:text 仅供 Android Studio 预览，避免维护者把预览占位值当成真实内容。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <!-- 顶栏：日期与周次信息 + 日期切换按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/layout_widget_header_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_widget_prev_day"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/widget_text_shadow"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="2026/9/20" />

            <TextView
                android:id="@+id/tv_widget_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/widget_text_shadow"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text=""
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                tools:text="2026-2027-1 | 第3周 周日" />
        </LinearLayout>

        <!-- 回退一天：文案描述「点下去会到哪一天」，越界时由 Provider 置为 INVISIBLE -->
        <TextView
            android:id="@+id/btn_widget_prev_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@id/btn_widget_toggle_day"
            android:padding="8dp"
            android:shadowColor="@color/widget_text_shadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            tools:text="← 昨日" />

        <!-- 前进一天 -->
        <TextView
            android:id="@+id/btn_widget_toggle_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:shadowColor="@color/widget_text_shadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            tools:text="明日 →" />
    </RelativeLayout>

    <!-- 中间状态：无课时的文具手绘插画状态 -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:id="@+id/iv_empty_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="无课插画"
            android:src="@drawable/ic_schedule_empty" />

        <TextView
            android:id="@+id/tv_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:shadowColor="@color/widget_text_shadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text=""
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            tools:text="今天没有课哦" />
    </LinearLayout>

    <!-- 中间状态：有课时的课程流列表状态 -->
    <LinearLayout
        android:id="@+id/layout_courses_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 当前/下一节课卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#26FFFFFF"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/tv_course1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/widget_text_shadow"
                android:shadowRadius="2"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                tools:text="08:00\n09:50" />

            <ImageView
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#80FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_course1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowRadius="3"
                    android:text=""
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="建筑制图" />

                <TextView
                    android:id="@+id/tv_course1_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowRadius="2"
                    android:text=""
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp"
                    tools:text="B203 | 郑杰" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第二节课卡片 -->
        <LinearLayout
            android:id="@+id/layout_course2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="#1AFFFFFF"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/tv_course2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/widget_text_shadow"
                android:shadowRadius="2"
                android:text=""
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"
                tools:text="14:00" />

            <ImageView
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#40FFFFFF" />

            <TextView
                android:id="@+id/tv_course2_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/widget_text_shadow"
                android:shadowRadius="2"
                android:text=""
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                tools:text="结构力学A上 | B524" />
        </LinearLayout>

        <!--
          第三门课及以后的提示，避免用户误以为当天只有两门课。
          为抵消这一行的高度，上方根布局与两张卡片的 padding 已整体收紧，总高度与改造前基本持平。
        -->
        <TextView
            android:id="@+id/tv_course_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="@color/widget_text_shadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="还有 3 门课" />
    </LinearLayout>

</LinearLayout>
