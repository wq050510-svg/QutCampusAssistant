<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的云备份 / 换机传输规则。
  allowBackup 已置为 false，这里再显式排除共享偏好（登录凭据、学号、姓名、GPA）
  与数据库（课表、成绩缓存），保证即使日后误开备份也不会有隐私数据外流。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
